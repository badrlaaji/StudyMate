# Copy to .env and fill in. Never commit .env.

# LLM (one provider, set here, never in code)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# langchain-google-genai 4.4.2 reads GOOGLE_API_KEY first, then GEMINI_API_KEY.
GOOGLE_API_KEY=

# Neon DIRECT connection (host without "-pooler"), asyncpg driver.
# asyncpg wants ssl=require: replace Neon's "sslmode=require&channel_binding=require".
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/neondb?ssl=require

# Optional
# EMBEDDING_MODEL=intfloat/multilingual-e5-small   # step 5: path of the fine-tuned model
# LLM_PAUSE_S=6                                     # pause between LLM calls in scripts
# TEST_DATABASE_URL=postgresql+asyncpg://...        # enables the database test
